# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor configs that aren't shared
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Node (in case anyone adds tooling later)
node_modules/

# Python
__pycache__/
*.pyc

# Local env / secrets
.env
.env.local

# 不要把任何项目的 docgen 运行产物 checkin 进 marketplace 仓库
docs/.docgen-state.json
docs/.docgen-scratch/

# 开发中间产物（设计稿 / 实现计划 / 草稿）放这里，不进仓库
.work/